# ============================================================
#  Sexta-Feira — configuração local
#  Copie este arquivo para ".env" e preencha os valores.
#  O arquivo .env NUNCA deve ser enviado ao GitHub (já está no .gitignore).
# ============================================================

# Chave da API da Anthropic (https://console.anthropic.com/settings/keys).
# Sem ela a Sexta-Feira roda em "modo offline" (interface funciona, mas sem IA).
ANTHROPIC_API_KEY=

# Endereço do servidor. Mantenha 127.0.0.1 para que só o seu computador acesse.
SEXTA_HOST=127.0.0.1
SEXTA_PORT=8765

# Onde ficam o banco de dados, o token de acesso e a lixeira.
# Padrão: ~/.sexta-feira
# SEXTA_DATA_DIR=

# Pasta de trabalho onde a Sexta-Feira pode ler/criar arquivos livremente
# (sempre respeitando as permissões). Padrão: ~/SextaFeira
# SEXTA_WORKSPACE_DIR=

# Pastas adicionais liberadas para as ferramentas de arquivos (separe por ";").
# Exemplo: SEXTA_FS_EXTRA_ROOTS=C:\Users\voce\Projetos;D:\Estudos
# SEXTA_FS_EXTRA_ROOTS=

# Orçamento diário de API em dólares (pode ser alterado na interface).
SEXTA_DAILY_BUDGET_USD=5.0

# Fuso horário usado no contexto enviado à IA (padrão: o do sistema).
# SEXTA_TIMEZONE=America/Sao_Paulo

# Modelos por camada (troque se quiser testar outros).
# SEXTA_MODEL_FAST=claude-haiku-4-5
# SEXTA_MODEL_BALANCED=claude-sonnet-5-5
# SEXTA_MODEL_DEEP=claude-opus-5-5

# Fallback automático quando um modelo recusa uma solicitação por engano
# (o servidor da Anthropic reexecuta em outro modelo). Recomendado: true.
# SEXTA_REFUSAL_FALLBACK=true

# Navegador da janela de voz (padrão: Chrome; se não houver, Edge).
# SEXTA_BROWSER=C:\Program Files\Google\Chrome\Application\chrome.exe
